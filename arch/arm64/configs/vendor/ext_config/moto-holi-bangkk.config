# bangkk hardware overrides, merged after the Qualcomm and common layers.
# Symbol names follow this stock tree, not the renamed common-tree symbols.
CONFIG_AF_NOISE_ELIMINATION=y
CONFIG_AWINIC_SAR=m
CONFIG_BANGKK_DTB=y
CONFIG_BOARD_USES_DOUBLE_TAP_CTRL=y
CONFIG_BQ25980_MMI_IIO=m
CONFIG_CAMERA_FLASH_IIC_COMPATIBLE=y
CONFIG_CAM_SENSOR_PROBE_RETRY=y
CONFIG_CCI_INTF=m
CONFIG_DRM_PANEL_NOTIFICATIONS=y
CONFIG_FELICA_MOUNT_BLOCK=y
CONFIG_FM_CTRL=m
CONFIG_FTS_DOUBLE_TAP_CONTROL=y
CONFIG_FTS_LAST_TIME=y
CONFIG_FTS_SUPPORT_HIGH_RESOLUTION=y
CONFIG_FTS_VDD_GPIO_CONTROL=y
CONFIG_GOODIX_ESD_ENABLE=y
CONFIG_GTP_FOD=y
CONFIG_GTP_LAST_TIME=y
CONFIG_GTP_LIMIT_USE_SUPPLIER=y
CONFIG_LDO_VIBRATOR_MMI=m
CONFIG_MMI_ANNOTATE=m
CONFIG_MMI_BQ25980_BULK_READ=y
CONFIG_MMI_INFO=m
CONFIG_MMI_PARALLEL_CHARGER_IIO=m
CONFIG_MMI_RELAY=m
CONFIG_MMI_SMBCHARGER_IIO=m
CONFIG_MMI_SYS_TEMP=m
CONFIG_MOT_DONGWOON_OIS_AF_DRIFT=y
CONFIG_MOT_SENSOR_PRE_POWERUP=y
CONFIG_NFC=y
CONFIG_QPNP_ADAPTIVE_CHARGE=m
CONFIG_QUP0_SE2_AP=y
CONFIG_RBS_FOD_MMI=m
# CONFIG_REGULATOR_QPNP_LCDB is not set
# CONFIG_SCSI_SKHPB is not set
CONFIG_SEC_NFC=m
CONFIG_SEC_NFC_DEDICATED_CLK=y
CONFIG_SEC_NFC_IF_I2C=y
CONFIG_SEC_NFC_LDO_EN=y
CONFIG_SEC_NFC_PMIC_LDO=y
CONFIG_SEC_NFC_PRODUCT_N5=y
CONFIG_SENSORS_CLASS=m
CONFIG_SND_SOC_AW87XXX=m
CONFIG_SX937X_SAR=m
CONFIG_TOUCHSCREEN_FTS_V3=m
CONFIG_TOUCHSCREEN_FTS_V3_ENABLE_DOUBLE_TAP=y
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_MMI=m
CONFIG_TOUCHSCREEN_MMI=m
# CONFIG_UFSFEATURE is not set
# CONFIG_UFSHPB is not set
# CONFIG_UFSTW is not set
CONFIG_UTAG=m
