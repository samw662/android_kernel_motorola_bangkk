# SM6375 platform/common overrides for the standalone bangkk kernel.
# Preserve the resolved stock baseline; module choices match SM6375 Lineage.
# First-build policy: retain the stock LTO/CFI-disable workaround.
CONFIG_ANDROID_SIMPLE_LMK=y
CONFIG_ANDROID_SIMPLE_LMK_MINFREE=128
CONFIG_ANDROID_SIMPLE_LMK_TIMEOUT_MSEC=200
# CONFIG_ARM_QCOM_CPUFREQ_HW_DEBUG is not set
# CONFIG_BLK_DEBUG_FS is not set
CONFIG_BTFM_SLIM=m
# CONFIG_BT_DEBUGFS is not set
CONFIG_BUILD_ARM64_DT_OVERLAY=y
# CONFIG_CFI_CLANG is not set
# CONFIG_CFI_CLANG_DEFCONFIG is not set
# CONFIG_CFI_CLANG_SHADOW is not set
# CONFIG_CMA_DEBUGFS is not set
CONFIG_CMDLINE="cgroup_disable=pressure panic_on_warn=0"
# CONFIG_COMMON_CLK_QCOM_DEBUG is not set
# CONFIG_CORESIGHT_CSR is not set
# CONFIG_CORESIGHT_CTI is not set
# CONFIG_CORESIGHT_CTI_SAVE_DISABLE is not set
# CONFIG_CORESIGHT_DUMMY is not set
# CONFIG_CORESIGHT_HWEVENT is not set
# CONFIG_CORESIGHT_LINK_AND_SINK_TMC is not set
# CONFIG_CORESIGHT_REMOTE_ETM is not set
# CONFIG_CORESIGHT_REMOTE_ETM_DEFAULT_ENABLE is not set
# CONFIG_CORESIGHT_TGU is not set
# CONFIG_CORESIGHT_TPDA is not set
# CONFIG_CORESIGHT_TPDM is not set
CONFIG_CRYPTO_ARCH_HAVE_LIB_CHACHA=y
CONFIG_CRYPTO_ARCH_HAVE_LIB_POLY1305=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_CHACHA20_NEON=y
CONFIG_CRYPTO_LIB_CHACHA=y
CONFIG_CRYPTO_LIB_CHACHA20POLY1305=y
CONFIG_CRYPTO_LIB_CURVE25519=y
CONFIG_CRYPTO_LIB_CURVE25519_GENERIC=y
CONFIG_CRYPTO_LIB_POLY1305=y
CONFIG_CRYPTO_LZO=m
CONFIG_CRYPTO_POLY1305=y
CONFIG_CRYPTO_POLY1305_NEON=y
# CONFIG_DEBUG_FS is not set
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y
CONFIG_EXFAT_DEFAULT_CODEPAGE=437
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_EXFAT_DISCARD=y
CONFIG_EXFAT_FS=m
CONFIG_FS_EPOLL_WAKEUP_DEBUG=y
# CONFIG_FUNCTION_ERROR_INJECTION is not set
CONFIG_HAVE_ARCH_PREL32_RELOCATIONS=y
# CONFIG_INTERCONNECT_TEST is not set
# CONFIG_KPROBES is not set
# CONFIG_KPROBES_QGKI is not set
# CONFIG_KPROBE_EVENTS is not set
# CONFIG_KRETPROBES is not set
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_PATH=y
# CONFIG_KSU_TRACEPOINT_HOOK is not set
CONFIG_LIB_MEMNEQ=y
CONFIG_LOCALVERSION="—WearyStars⭐"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LRU_GEN=y
# CONFIG_LTO is not set
# CONFIG_LTO_CLANG is not set
CONFIG_LTO_NONE=y
CONFIG_LZO_COMPRESS=m
CONFIG_LZO_DECOMPRESS=m
# CONFIG_MICRON_HPB is not set
CONFIG_MMAP_READAROUND_LIMIT=y
CONFIG_MMI_DEVICE_DTBS=y
CONFIG_MOTO_F_USBNET=y
CONFIG_MOTO_MM=y
CONFIG_MSM_BT_POWER=m
# CONFIG_MSM_IDLE_STATS is not set
# CONFIG_MSM_IDLE_STATS_BUCKET_COUNT is not set
# CONFIG_MSM_IDLE_STATS_BUCKET_SHIFT is not set
# CONFIG_MSM_IDLE_STATS_FIRST_BUCKET is not set
CONFIG_MSM_RDBG=m
# CONFIG_MSM_REMOTEQDSS is not set
# CONFIG_MSM_SUSPEND_STATS_FIRST_BUCKET is not set
CONFIG_MSM_TZ_QSEE_LOG=y
# CONFIG_NET_ACT_BPF is not set
# CONFIG_NET_ACT_POLICE is not set
# CONFIG_NET_CLS_MATCHALL is not set
CONFIG_NET_SCH_FQ=y
# CONFIG_NFC_QTI_I2C is not set
# CONFIG_PAGE_EXTENSION is not set
# CONFIG_PAGE_OWNER is not set
CONFIG_QCA_CLD_WLAN=m
# CONFIG_REGMAP_ALLOW_WRITE_DEBUGFS is not set
# CONFIG_REGMAP_QTI_DEBUG is not set
# CONFIG_REGULATOR_QTI_DEBUG is not set
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_SEC_ESE_COLDRESET=y
# CONFIG_SERIAL_8250_DW is not set
# CONFIG_SERIAL_8250_DWLIB is not set
CONFIG_SERIAL_MSM_GENI_CONSOLE=y
CONFIG_SERIAL_MSM_GENI_EARLY_CONSOLE=y
# CONFIG_SMB1355_SLAVE_CHARGER is not set
# CONFIG_SMB1398_CHARGER is not set
# CONFIG_STACKDEPOT is not set
# CONFIG_STACK_HASH_ORDER_SHIFT is not set
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_BIC=m
CONFIG_TCP_CONG_HTCP=m
CONFIG_TCP_CONG_WESTWOOD=y
# CONFIG_THERMAL_STATISTICS is not set
# CONFIG_THINLTO is not set
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_TOUCHSCREEN_FTS_DIRECTORY is not set
# CONFIG_TOUCHSCREEN_NT36XXX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_CORE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE_EXTRA_SYSFS is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_I2C is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_RMI_DEV is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_TEST_REPORTING is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_CORE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_DEVICE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_DIAGNOSTICS is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_I2C is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_RECOVERY is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_REFLASH is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_TESTING is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_TOUCH is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_ZEROFLASH is not set
# CONFIG_UFSHID is not set
# CONFIG_UFSHID_POC is not set
# CONFIG_UFSTW_BOOT_ENABLED is not set
# CONFIG_UFSTW_IGNORE_GUARANTEE_BIT is not set
# CONFIG_USB_NET_AQC111 is not set
# CONFIG_USB_NET_CDC_EEM is not set
# CONFIG_USB_NET_CDC_NCM is not set
# CONFIG_USB_RTL8150 is not set
CONFIG_WIREGUARD=y
CONFIG_ZRAM=m
CONFIG_ZRAM_WRITEBACK=y
